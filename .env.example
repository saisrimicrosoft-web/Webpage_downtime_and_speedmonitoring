# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# JWT secret — can be the same as SECRET_KEY or a separate value
JWT_SECRET_KEY=change-me-to-a-random-string

# JWT token expiry in hours (default: 72)
JWT_EXPIRY_HOURS=72

# Database URI (SQLite for local, or postgres://... for production)
DATABASE_URI=sqlite:///monitor.db

# Discord Webhook URL for downtime alerts (optional)
DISCORD_WEBHOOK_URL=

# Monitoring interval in seconds (default: 60)
CHECK_INTERVAL_SECONDS=60

# HTTP request timeout in seconds (default: 10)
REQUEST_TIMEOUT_SECONDS=10

# SSL certificate expiry warning threshold in days (default: 30)
SSL_WARNING_DAYS=30

# Supabase (optional — leave blank to use local SQLite only)
SUPABASE_URL=
SUPABASE_KEY=

# SMTP for email alerts (optional — leave blank to log-only mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
