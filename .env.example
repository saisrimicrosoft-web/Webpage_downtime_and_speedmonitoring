# Universal Early Warning System — Environment Configuration
# Copy this file to .env and fill in your values.

# Flask secret key
SECRET_KEY=change-me-to-a-random-string

# Database URI (SQLite for local dashboard)
DATABASE_URI=sqlite:///monitor.db

# ── Supabase Configuration (Person B: Data & Alerts Pipeline) ──
# Project URL from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service Role Key (bypasses RLS — keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Webhook URLs for alerts ──
# Get from Discord channel settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# Monitoring interval in seconds (default: 60)
CHECK_INTERVAL_SECONDS=60

# HTTP request timeout in seconds (default: 10)
REQUEST_TIMEOUT_SECONDS=10

# SSL certificate expiry warning threshold in days (default: 30)
SSL_WARNING_DAYS=30

# Supabase Database Sync Configuration
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

